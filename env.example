# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=KK Jewelry Shop

# Payment Configuration (Optional - for production)
# NOTCHPAY_API_KEY=your-notchpay-api-key
# NOTCHPAY_SECRET_KEY=your-notchpay-secret-key

# Admin Configuration
ADMIN_EMAIL=admin@kkjewelry.com
ADMIN_PASSWORD=admin123

# Database Configuration (if using external database)
# DATABASE_URL=postgresql://user:password@localhost:5432/kkjewelry

# Email Configuration (Optional)
# RESEND_API_KEY=your-resend-api-key
# FROM_EMAIL=noreply@kkjewelry.com

# File Upload Configuration (Optional)
# UPLOAD_ACCESS_KEY=your-upload-access-key
# UPLOAD_SECRET_KEY=your-upload-secret-key
# UPLOAD_REGION=us-east-1
# UPLOAD_BUCKET=kkjewelry-uploads
